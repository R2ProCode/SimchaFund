@using SimchaFund.Web.Models
@model HistoryViewModel

<div class="header">
	<h1>
		History for @Model.ContributorName
	</h1>
	<h3>Current Balance: @Model.Balance.ToString("$0.00;-$0.00")</h3>
</div>
<div class="row header">
	<div class="table-responsive">
		<table class="table table-bordered table-striped">
			<thead>
				<tr>
					<th>Action</th>
					<th>Date</th>
					<th>Amount</th>
				</tr>
			</thead>

			<tbody>
				@foreach (var history in Model.Histories)
				{
					<tr>
						<td>@history.Action</td>
						<td>@history.Date.ToLongDateString()</td>
						<td>@(history.Action == "Deposit" ? history.Amount.ToString("C"): history.Amount.ToString("-$0.00"))</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

<div style="text-align:center;">
	<a class="btn btn-lg btn-danger" href="/contributors">Back to Contributors</a>
</div>
