@using SimchaFund.Web.Models
@model ContributorsViewModel

<div>
	<h1>Contributors</h1>
</div>
<div class="row align-items-center">
	<div class="col-md-auto">
		<button class="btn btn-danger" id="new-contributor">New Contributor</button>
	</div>
	<div class="col-md-5">
		<div class="input-group">
			<input type="text" class="form-control" placeholder="Search" id="search" />
			<button class="btn btn-outline-danger" id="clear">Clear</button>
		</div>
	</div>
	<div class="col-md-auto ms-auto">
		<span class="h4 mb-0 fw-bold">Total: @Model.TotalContributions.ToString("C")</span>
	</div>

</div>
<div class="table-responsive">
	<table class="table table-striped table-bordered">
		<thead>
			<tr>
				<th>Deposit</th>
				<th>Name</th>
				<th>Cell</th>
				<th>Balance</th>
				<th>Always Include</th>
				<th>Actions</th>
			</tr>
		</thead>

		<tbody>
			@foreach (var contributor in Model.Contributors)
			{
				<tr>
					<td>
						<button class="btn btn-success deposit-button" data-id="@contributor.ContributorId">Deposit</button>
					</td>
					<td>@(contributor.FirstName + " " + contributor.LastName)</td>
					<td>@contributor.CellNumber</td>
					<td>@contributor.Balance.Value.ToString("$0.00;-$0.00")</td>
					<td style="text-align: center;">
						<i style="font-size:30px" class="@(contributor.AlwaysInclude ? "bi bi-check" : "")"></i>
					</td>
					<td>
						<a href="/contributors/history?contributorId=@contributor.ContributorId" class="btn btn-primary">Show History</a>
						<button data-first-name="@contributor.FirstName" data-last-name="@contributor.LastName"
								data-cell="@contributor.CellNumber" data-id="@contributor.ContributorId" data-always-include="@contributor.AlwaysInclude" data-date="@contributor.Date"
								class="btn btn-danger edit-contributor">
							Edit
						</button>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

<div class="modal fade new-contributor" tabindex="-1" role="dialog">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Contributor</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form method="post" action="/contributors/new">
				<div class="modal-body">
					<div class="row">
						<div class="form-group col-md-6">
							<label class="form-label">First Name</label>
							<input class="form-control" id="contributor_first_name" name="firstName" placeholder="First Name" type="text" required>
						</div>
						<div class="form-group col-md-6">
							<label class="form-label">Last Name</label>
							<input class="form-control" id="contributor_last_name" name="lastName" placeholder="Last Name" type="text" required>
						</div>
					</div>
					<div class="row mt-3">
						<div class="form-group col-md-6">
							<label class="form-label">Cell Number</label>
							<input class="form-control" id="contributor_cell_number" name="cellNumber" placeholder="Cell Number" type="text">
						</div>
						<div class="form-group col-md-6" id="initialDepositDiv">
							<label class="form-label">Initial Deposit</label>
							<input type="number" step="0.01" class="form-control" name="initialDeposit" placeholder="Initial Deposit">
						</div>
					</div>
					<div class="row mt-3 align-items-end">
						<div class="form-group col-md-6">
							<label class="form-label">Created Date</label>
							<input class="form-control" id="contributor_created_at" name="date" type="date">
						</div>
						
						<div class="col-md-6 pb-2">
							<div class="form-check ms-3">
								<input type="checkbox" class="form-check-input" id="contributor_always_include" name="alwaysInclude" value="true">
								<label class="form-check-label" for="contributor_always_include">Always Include</label>
							</div>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-primary">Save</button>
				</div>
			</form>
		</div>
	</div>
</div>


<div class="modal fade edit-modal" tabindex="-1" role="dialog">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Contributor</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form method="post" action="/contributors/edit">
				
				<input type="hidden" id="edit_id" name="contributorId" value="" />

				<div class="modal-body">
					<div class="row">
						<div class="form-group col-md-6">
							<label class="form-label">First Name</label>
							<input class="form-control" id="edit-contributor_first_name" name="firstName" placeholder="First Name" type="text" required>
						</div>
						<div class="form-group col-md-6">
							<label class="form-label">Last Name</label>
							<input class="form-control" id="edit-contributor_last_name" name="lastName" placeholder="Last Name" type="text" required>
						</div>
					</div>
					<div class="row mt-3 align-items-end">
						<div class="form-group col-md-6">
							<label class="form-label">Cell Number</label>
							<input class="form-control" id="edit-contributor_cell_number" name="cellNumber" placeholder="Cell Number" type="text">
						</div>
						
						<div class="col-md-6 pb-2">
							
							<div class="form-check ms-3">
								<input type="checkbox" class="form-check-input" id="edit-contributor_always_include" name="alwaysInclude" value="true">
								<label class="form-check-label" for="edit-contributor_always_include">Always Include</label>
							</div>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-primary">Update</button>
				</div>
			</form>
		</div>
	</div>
</div>

<div class="modal fade deposit" tabindex="-1" role="dialog">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Deposit for <span id="deposit-name"></span></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form method="post" action="/contributors/deposit">
				<input type="hidden" name="contributorId" value="" />
				<div class="modal-body">
					<div class="form-group">
						<label class="form-label">Amount</label>
						<input class="form-control" name="amount" placeholder="Deposit Amount" type="text">
					</div>
					<div class="form-group">
						<label class="form-label">Date</label>
						<input type="date" name="date" class="form-control" id="datepicker">
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
					<input class="btn btn-primary" name="commit" type="submit" value="Save">
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts
{
	<script src="/js/contributor-index.js"></script>
}
